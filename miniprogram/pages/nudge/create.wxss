/* P08 · 叮一下 —— 页面级样式；通用样式在 app.wxss */

/* ---------- 叮什么 ---------- */

.nudge__to {
  margin-bottom: 8px;
  font-size: var(--fs-cap);
  color: var(--brand-ink);
}

.field__textarea {
  width: 100%;
  min-height: 30px;
  font-size: var(--fs-h2);
  line-height: 1.6;
  color: var(--ink-1);
}

/* ---------- 现在就叮 / 定时叮 ---------- */

.seg {
  display: flex;
  padding: 4px;
  border: 1px solid var(--line);
  border-radius: var(--radius-pill);
  background: var(--surface);
}

.seg__item {
  flex: 1;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-pill);
  font-size: var(--fs-body);
  color: var(--ink-2);
}

.seg__item:active {
  opacity: 0.7;
}

.seg__item--on {
  background: linear-gradient(135deg, #ff9db4 0%, #ffb59b 100%);
  color: #ffffff;
  font-weight: 600;
}

.nudge__when {
  margin-top: 12px;
}

/* ---------- 提交 ---------- */

.nudge__submit {
  margin-top: 24px;
}

.nudge__submit--off {
  opacity: 0.6;
}
