/* P03 · 留个念（Tab 3）—— 时间线 */

/* ============================================================
   骨架（不用转圈：骨架块顺带说明「马上出来什么形状」）
   ============================================================ */

.skel {
  margin-bottom: 22px;
}

.skel__date {
  width: 78px;
  height: 12px;
  margin-bottom: 10px;
  border-radius: var(--radius-sm);
  background: var(--surface-2);
}

.skel__card {
  padding: 16px;
  border-radius: var(--radius-lg);
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.skel__line {
  height: 14px;
  border-radius: var(--radius-sm);
  background: var(--surface-2);
}

.skel__line--short {
  width: 55%;
  margin-top: 10px;
}

/* ============================================================
   空状态
   ============================================================ */

.empty__title {
  padding: 0 12px;
  text-align: center;
}

/* ============================================================
   按日分组
   ============================================================ */

.day {
  margin-bottom: 22px;
}

.day__date {
  margin: 0 0 10px 4px;
  font-size: var(--fs-cap);
  font-weight: 600;
  color: var(--ink-3);
  letter-spacing: 0.5px;
}

/* ============================================================
   记录卡片
   ============================================================ */

.mcard {
  padding: 16px;
  border-radius: var(--radius-lg);
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.mcard + .mcard {
  margin-top: 12px;
}

.mcard__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mcard__who {
  display: flex;
  align-items: center;
  min-width: 0;
}

.mcard__avatar {
  width: 26px;
  height: 26px;
  margin-right: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}

/* 头像为空时的兜底：称谓首字，粉底粉字（与 member-picker 一致） */
.mcard__avatar--text {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-soft);
  color: var(--brand-ink);
  font-size: var(--fs-cap);
  font-weight: 600;
}

.mcard__name {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink-1);
}

.mcard__right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

/* 仅自己可见的小锁 —— 不给个标记，用户会以为家里人都看得到 */
.mcard__lock {
  margin-right: 6px;
  font-size: var(--fs-cap);
}

.mcard__time {
  font-size: var(--fs-cap);
  color: var(--ink-3);
}

.mcard__more {
  /* 触控目标要比字形大：··· 本身只有几个像素宽 */
  padding: 0 2px 0 12px;
  color: var(--ink-3);
  font-size: var(--fs-h3);
  line-height: 1;
}

.mcard__more:active {
  opacity: 0.5;
}

.mcard__body {
  margin-top: 12px;
}

.mcard__text {
  display: block;
  font-size: var(--fs-h3);
  color: var(--ink-1);
  line-height: 1.7;
  /* 长文在卡片里折行，不撑破布局 */
  word-break: break-word;
}

/* ============================================================
   九宫格
   ============================================================ */

.grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12px;
}

.grid__cell {
  /* 三列：每列 1/3 宽，用 padding 做间距（WXSS 的 gap 在旧基础库上不稳） */
  width: 33.333%;
  box-sizing: border-box;
  padding: 3px;
}

.grid__img {
  display: block;
  width: 100%;
  /* 正方形裁切。这里给固定高度而不是 padding-bottom 撑比例：
     image 组件不参与百分比高度，用 padding 撑出来的框会留白 */
  height: 96px;
  border-radius: var(--radius-sm);
  background: var(--surface-2);
}

.grid__cell--more {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96px;
  padding: 3px;
  border-radius: var(--radius-sm);
  background: var(--surface-2);
  color: var(--ink-2);
  font-size: var(--fs-h3);
}

/* ============================================================
   加载更多
   ============================================================ */

.more {
  padding: 8px 0 4px;
  font-size: var(--fs-cap);
  color: var(--ink-3);
  text-align: center;
}

/* ============================================================
   悬浮发布按钮
   ============================================================ */

.fab {
  position: fixed;
  right: 24px;
  /* 抬起一点，别压在 Tab 栏上（Tab 栏约 50px + 安全区） */
  bottom: calc(66px + env(safe-area-inset-bottom));
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54px;
  height: 54px;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff9db4 0%, #ffb59b 100%);
  color: #ffffff;
  font-size: 28px;
  line-height: 1;
  box-shadow: var(--shadow-float);
}

.fab:active {
  opacity: 0.86;
}
