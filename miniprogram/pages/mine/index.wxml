<!-- P20 · 我的（Tab 4） -->
<view class="page">
  <!-- 抬头：家庭称谓 + 在哪个家 -->
  <view class="profile">
    <view class="profile__avatar">👤</view>
    <view class="profile__info">
      <view class="profile__name">{{profile.nickname}}</view>
      <view class="profile__role">{{profile.roleLine}}</view>
    </view>
  </view>

  <!-- 家庭 -->
  <view class="section-title">家庭</view>
  <view class="card cells">
    <view class="cell" bindtap="onFamilyInfo">
      <text class="cell__emoji">🏡</text>
      <text class="cell__label">{{familyName}}</text>
      <text class="cell__extra">{{memberCountText}}</text>
      <text class="cell__arrow">›</text>
    </view>
    <view class="cell" bindtap="onMembers">
      <text class="cell__emoji">👥</text>
      <text class="cell__label">家庭成员</text>
      <text class="cell__arrow">›</text>
    </view>
    <view class="cell" bindtap="onInvite">
      <text class="cell__emoji">➕</text>
      <text class="cell__label">邀请家人</text>
      <text class="cell__arrow">›</text>
    </view>
    <view class="cell" bindtap="onSetting">
      <text class="cell__emoji">⚙️</text>
      <text class="cell__label">家庭设置</text>
      <text class="cell__arrow">›</text>
    </view>
  </view>

  <!-- 消息与提醒 -->
  <view class="section-title">消息与提醒</view>
  <view class="card cells">
    <view class="cell" bindtap="onNotice">
      <text class="cell__emoji">💬</text>
      <text class="cell__label">消息中心</text>
      <text class="cell__badge" wx:if="{{unread.show}}">{{unread.text}}</text>
      <text class="cell__arrow">›</text>
    </view>
    <view class="cell" bindtap="onWechatNotify">
      <text class="cell__emoji">🔔</text>
      <text class="cell__label">微信提醒</text>
      <text class="cell__extra {{wechat.warn ? 'cell__extra--warn' : ''}}">{{wechat.text}}</text>
      <text class="cell__arrow">›</text>
    </view>
  </view>

  <!-- 其他 -->
  <view class="section-title">其他</view>
  <view class="card cells">
    <view class="cell" bindtap="onAbout">
      <text class="cell__emoji">ℹ️</text>
      <text class="cell__label">关于「家有小事」</text>
      <text class="cell__arrow">›</text>
    </view>
  </view>

  <!-- 退出家庭：创建者没有这个按钮，换成一行说明（判据在 utils/mine-view.ts） -->
  <view class="leave">
    <view class="leave__btn" wx:if="{{leave.show}}" bindtap="onLeave">退出家庭</view>
    <view class="leave__hint" wx:else>{{leave.hint}}</view>
  </view>

  <view class="version">家有小事 · v0.1</view>
</view>
