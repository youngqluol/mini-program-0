<view class="page">
  <view class="skeleton-note">骨架预览：登录与家庭数据在 M1 接入。</view>

  <view class="profile">
    <view class="profile__avatar">👤</view>
    <view class="profile__info">
      <view class="profile__name">还没登录</view>
      <view class="profile__role">登录后显示你在家里的称谓</view>
    </view>
  </view>

  <view class="section-title">我的</view>

  <view class="card card--tight">
    <view
      class="cell"
      wx:for="{{cells}}"
      wx:key="key"
      bindtap="onCellTap"
      data-key="{{item.key}}"
    >
      <text class="cell__emoji">{{item.emoji}}</text>
      <text class="cell__label">{{item.label}}</text>
      <text class="cell__extra" wx:if="{{item.extra}}">{{item.extra}}</text>
      <text class="cell__arrow">›</text>
    </view>
  </view>

  <view class="version">家有小事 · v0.1 骨架</view>
</view>
