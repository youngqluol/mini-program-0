<!-- P22 · 隐私政策 -->
<view class="page">
  <view class="pp-head">
    <view class="pp-head__title">隐私政策</view>
    <view class="pp-head__meta">更新于 {{updatedAt}}</view>
  </view>

  <view class="pp-lead">{{lead}}</view>

  <view class="card pp-sec" wx:for="{{sections}}" wx:key="title">
    <view class="pp-sec__title">{{item.title}}</view>
    <view class="pp-sec__line" wx:for="{{item.lines}}" wx:for-item="line" wx:key="*this">{{line}}</view>
  </view>

  <view class="pp-foot">家有小事 · v0.1</view>
</view>
