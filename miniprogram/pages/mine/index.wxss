.profile {
  display: flex;
  align-items: center;
  padding: 20px;
  border-radius: var(--radius-lg);
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.profile__avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56px;
  height: 56px;
  border-radius: var(--radius-tile);
  background: var(--pastel-pink);
  font-size: 28px;
  line-height: 1;
}

.profile__info {
  margin-left: 14px;
  flex: 1;
  min-width: 0;
}

.profile__name {
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--ink-1);
}

.profile__role {
  margin-top: 2px;
  font-size: var(--fs-cap);
  color: var(--ink-3);
}

/* ---------- 列表项 ---------- */

.cell {
  display: flex;
  align-items: center;
  padding: 14px 0;
}

.cell + .cell {
  border-top: 1px solid var(--line);
}

.cell:active {
  opacity: 0.7;
}

.cell__emoji {
  width: 32px;
  font-size: 18px;
  line-height: 1;
}

.cell__label {
  flex: 1;
  font-size: var(--fs-h3);
  color: var(--ink-1);
}

.cell__extra {
  margin-right: 6px;
  font-size: var(--fs-cap);
  color: var(--ink-3);
}

.cell__arrow {
  font-size: 18px;
  color: var(--ink-3);
}

/* ---------- 版本号 ---------- */

.version {
  margin-top: 24px;
  text-align: center;
  font-size: var(--fs-cap);
  color: var(--ink-3);
}
