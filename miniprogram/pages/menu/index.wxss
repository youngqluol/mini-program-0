.wheel {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36px 20px 28px;
  border-radius: var(--radius-lg);
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.wheel__question {
  font-size: var(--fs-h2);
  color: var(--ink-2);
}

.wheel__dish {
  margin: 16px 0 28px;
  font-size: var(--fs-display);
  font-weight: 700;
  color: var(--brand-ink);
}

.wheel__btn {
  width: 100%;
}
