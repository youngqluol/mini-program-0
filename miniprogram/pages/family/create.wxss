/* P05 · 创建家庭 */

.create__hero {
  padding: 24px 0 22px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* emoji 装粉彩 squircle 色块（docs/07 §6.3） */
.create__logo {
  width: 64px;
  height: 64px;
  border-radius: 20px;
  background: var(--pastel-peach);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32px;
  line-height: 1;
  box-shadow: var(--shadow-card);
}

.create__title {
  margin-top: 16px;
  font-size: var(--fs-h1);
  font-weight: 700;
  color: var(--ink-1);
}

.create__sub {
  margin-top: 6px;
  font-size: var(--fs-cap);
  color: var(--ink-3);
}

.create__submit {
  margin-top: 24px;
}

.create__submit--busy {
  opacity: 0.7;
}

.create__alt {
  margin-top: 20px;
  text-align: center;
  font-size: var(--fs-body);
  color: var(--ink-2);
}

.create__alt-link {
  margin-left: 4px;
  color: var(--brand-ink);
  font-weight: 600;
}
