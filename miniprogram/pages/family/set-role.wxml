<!-- P07 · 设置称谓 -->
<view class="page">
  <view class="setrole__hero">
    <view class="setrole__title">你在「{{familyName}}」里叫什么</view>
    <view class="setrole__sub">家里人给你的消息里，会用这个称呼</view>
  </view>

  <view class="card">
    <view class="field field--last">
      <view class="field__label">称谓</view>
      <input
        class="field__input"
        value="{{roleName}}"
        placeholder="例如：阿妈"
        placeholder-class="field__placeholder"
        maxlength="30"
        bindinput="onRoleInput"
      />
      <view class="chips">
        <view
          wx:for="{{roleSuggestions}}"
          wx:key="*this"
          class="chip {{roleName === item ? 'chip--on' : ''}}"
          data-role="{{item}}"
          bindtap="onPickRole"
        >{{item}}</view>
      </view>
    </view>
  </view>

  <view class="btn-primary setrole__submit {{saving ? 'setrole__submit--busy' : ''}}" bindtap="onSave">
    {{saving ? '正在保存…' : '保存'}}
  </view>
</view>
