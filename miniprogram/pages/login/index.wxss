/* P04 · 授权登录 */

.login {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding-bottom: 72px;
  box-sizing: border-box;
}

/* ---------- 品牌区 ---------- */

.login__brand {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 40px;
}

/* emoji 装粉彩 squircle 色块（docs/07 §6.3） */
.login__logo {
  width: 92px;
  height: 92px;
  border-radius: 28px;
  background: var(--pastel-pink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46px;
  line-height: 1;
  box-shadow: var(--shadow-card);
}

.login__title {
  margin-top: 22px;
  font-size: var(--fs-display);
  font-weight: 700;
  letter-spacing: 1px;
  color: var(--ink-1);
}

.login__slogan {
  margin-top: 10px;
  font-size: var(--fs-h3);
  color: var(--ink-2);
}

/* ---------- 操作区 ---------- */

.login__actions {
  padding: 0 4px;
}

.login__btn {
  width: 100%;
}

.login__btn--busy {
  opacity: 0.7;
}

.login__tip {
  margin-top: 14px;
  text-align: center;
  font-size: var(--fs-cap);
  color: var(--ink-3);
}
