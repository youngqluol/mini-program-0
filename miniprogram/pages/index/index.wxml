<view class="page">
  <view class="skeleton-note">骨架预览：下面是真实布局，数据接入在 M1 完成。</view>

  <!-- 家庭抬头 -->
  <view class="hero">
    <view class="hero__name">{{familyName}}</view>
    <view class="hero__sub">今天家里有什么小事？</view>
  </view>

  <!-- 未开微信提醒提示条 -->
  <view class="notify-bar" bindtap="onOpenNotifySetting">
    <text class="notify-bar__text">还没开微信提醒，可能收不到消息</text>
    <text class="notify-bar__action">去开启</text>
  </view>

  <!-- 两个高频动作 -->
  <view class="quick">
    <view class="quick__item quick__item--nudge" bindtap="onNudge">
      <text class="quick__emoji">🔔</text>
      <text class="quick__label">叮一下</text>
      <text class="quick__desc">别忘了</text>
    </view>
    <view class="quick__item quick__item--task" bindtap="onAssign">
      <text class="quick__emoji">🎯</text>
      <text class="quick__label">派活</text>
      <text class="quick__desc">有人做</text>
    </view>
  </view>

  <!-- 今天的小事 -->
  <view class="section-title">今天的小事</view>
  <view class="card">
    <view class="empty">
      <text class="empty__emoji">🌿</text>
      <text class="empty__title">今天家里很安静</text>
      <text class="empty__hint">有事了，就叮一下</text>
    </view>
  </view>
</view>
