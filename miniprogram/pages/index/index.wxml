<!-- P01 · 家里（Tab 1）—— 只回答「今天家里有什么事」 -->
<view class="page">
  <!-- 家庭抬头：纯上下文，不可点（家庭管理在「我的」Tab） -->
  <view class="hero">
    <view class="hero__name">{{familyName}}</view>
    <view class="hero__sub">{{dateLine}}</view>
  </view>

  <!-- 两个高频动作 -->
  <view class="quick">
    <view class="quick__item quick__item--nudge" bindtap="onNudge">
      <text class="quick__emoji">🔔</text>
      <text class="quick__label">叮一下</text>
      <text class="quick__desc">别忘了</text>
    </view>
    <view class="quick__item quick__item--task" bindtap="onAssign">
      <text class="quick__emoji">🎯</text>
      <text class="quick__label">派个活</text>
      <text class="quick__desc">有人做</text>
    </view>
  </view>

  <!-- 加载中：骨架块，不用转圈 -->
  <block wx:if="{{loading}}">
    <view class="skel">
      <view class="skel__head"></view>
      <view class="skel__row"></view>
      <view class="skel__row"></view>
    </view>
    <view class="skel">
      <view class="skel__head"></view>
      <view class="skel__row"></view>
    </view>
  </block>

  <!-- 今天确实没有小事 -->
  <view wx:elif="{{quiet}}" class="card quiet">
    <text class="quiet__emoji">📭</text>
    <text class="quiet__title">今天还没有小事</text>
    <text class="quiet__hint">要不要先叮一下阿妈？</text>
  </view>

  <block wx:else>
    <!-- 今天的提醒 -->
    <block wx:if="{{reminderRows.length > 0}}">
      <view class="sec">
        <view class="section-title sec__title">今天的提醒</view>
        <view class="sec__more" bindtap="onMoreReminders">更多 ›</view>
      </view>
      <view class="rows">
        <view class="row" wx:for="{{reminderRows}}" wx:key="id">
          <thing-card
            item="{{item.card}}"
            variant="today"
            showCheck="{{item.canCheck}}"
            bind:click="onOpenThing"
            bind:complete="onCompleteReminder"
          />
        </view>
      </view>
    </block>

    <!-- 最近的活 -->
    <block wx:if="{{taskRows.length > 0}}">
      <view class="sec">
        <view class="section-title sec__title">最近的活</view>
        <view class="sec__more" bindtap="onMoreTasks">更多 ›</view>
      </view>
      <view class="rows">
        <view class="row" wx:for="{{taskRows}}" wx:key="id">
          <thing-card item="{{item}}" variant="today" showStatus="{{true}}" bind:click="onOpenThing" />
        </view>
      </view>
    </block>
  </block>

  <!-- 吃啥呢 -->
  <view class="jump" bindtap="onMenu">
    <text class="jump__emoji">🍽️</text>
    <view class="jump__main">
      <view class="jump__title">吃啥呢</view>
      <view class="jump__sub">今天吃什么？</view>
    </view>
    <text class="jump__arrow">›</text>
  </view>

  <!-- 留个念（M4-11）：副标题是**最新一条**，没有就直说没有 -->
  <view class="jump" bindtap="onMemory">
    <text class="jump__emoji">📖</text>
    <view class="jump__main">
      <view class="jump__title">留个念</view>
      <view class="jump__sub">{{memoryPreview}}</view>
    </view>
    <text class="jump__arrow">›</text>
  </view>

  <!-- 隐私协议提示（M5-5）：只在「首次进入」且微信说还没同步过时出现。
       「同意」走 open-type，微信据此记录同步状态，不需要我们调接口；
       其余场景（比如用户没理这一层、直接去发照片）由微信官方弹窗兜底。 -->
  <view wx:if="{{showPrivacy}}" class="privacy">
    <view class="privacy__mask" bindtap="onDismissPrivacy"></view>
    <view class="privacy__panel">
      <view class="privacy__title">先说一句</view>
      <view class="privacy__body">发「留个念」要从相册选照片。点「同意」表示你已阅读并同意{{privacyContractName}}。</view>
      <view class="privacy__acts">
        <view class="privacy__btn privacy__btn--ghost" bindtap="onOpenPrivacy">查看指引</view>
        <button
          class="privacy__btn privacy__btn--main"
          open-type="agreePrivacyAuthorization"
          bindagreeprivacyauthorization="onAgreePrivacy"
        >同意</button>
      </view>
    </view>
  </view>
</view>
