/**
 * 全局样式
 * 令牌定义见 styles/variables.wxss（唯一来源：docs/07 §11.1）
 */
@import './styles/variables.wxss';

page {
  background: var(--bg);
  color: var(--ink-1);
  font-family: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: var(--fs-body);
  line-height: 1.6;
}

/* ============================================================
   布局
   ============================================================ */

.page {
  /* 大屏（iPad / 微信 PC 端）下约束内容宽度并居中，避免内容被拉宽。
     480px > 最大手机宽度（iPhone Pro Max 约 430pt），手机端不受影响。
     单位选择理由见 docs/07 §5.2。 */
  max-width: 480px;
  margin: 0 auto;
  padding: 16px 16px 32px;
  box-sizing: border-box;
}

/* ============================================================
   卡片
   ============================================================ */

.card {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 20px;
  box-shadow: var(--shadow-card);
}

.card + .card {
  margin-top: 14px;
}

.card--tight {
  padding: 16px;
}

/* ============================================================
   区块标题（粉色小竖条，不用 emoji）
   ============================================================ */

.section-title {
  display: flex;
  align-items: center;
  margin: 20px 0 12px;
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--ink-1);
}

.section-title::before {
  content: '';
  width: 4px;
  height: 16px;
  margin-right: 8px;
  border-radius: 2px;
  background: linear-gradient(180deg, var(--brand-1) 0%, var(--brand-2) 100%);
}

/* ============================================================
   按钮
   ============================================================ */

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 48px;
  border-radius: var(--radius-pill);
  background: linear-gradient(135deg, #ff9db4 0%, #ffb59b 100%);
  color: #ffffff;
  font-size: var(--fs-h3);
  font-weight: 600;
  box-shadow: var(--shadow-float);
}

.btn-primary:active {
  opacity: 0.86;
}

.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 48px;
  border-radius: var(--radius-pill);
  background: var(--brand-soft);
  color: var(--brand-ink);
  font-size: var(--fs-h3);
  font-weight: 600;
}

.btn-ghost:active {
  opacity: 0.86;
}

/* ============================================================
   胶囊标签
   ============================================================ */

.pill {
  display: inline-flex;
  align-items: center;
  height: 24px;
  padding: 0 10px;
  border-radius: var(--radius-pill);
  background: var(--brand-soft);
  color: var(--brand-ink);
  font-size: var(--fs-cap);
}

/* ============================================================
   表单
   ============================================================ */

.field {
  padding: 4px 0 14px;
  border-bottom: 1px solid var(--line);
}

.field + .field {
  padding-top: 16px;
}

.field--last {
  padding-bottom: 0;
  border-bottom: none;
}

.field__label {
  margin-bottom: 8px;
  font-size: var(--fs-cap);
  color: var(--ink-2);
}

.field__input {
  height: 30px;
  font-size: var(--fs-h2);
  color: var(--ink-1);
}

.field__placeholder {
  color: var(--ink-3);
  font-size: var(--fs-h2);
}

/* 字段下方的解释 / 提示。用于「为什么这块现在不能用」这类说明 —— 
   不要拿它写校验错误，那种情况走 toast。 */
.field__hint {
  margin-top: 8px;
  font-size: var(--fs-cap);
  color: var(--ink-3);
}

/* 快捷选项 chips —— 点一下就填上，别让用户自己想 */
.chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12px;
}

.chip {
  display: inline-flex;
  align-items: center;
  height: 30px;
  padding: 0 14px;
  margin: 0 8px 8px 0;
  border-radius: var(--radius-pill);
  background: var(--surface-2);
  color: var(--ink-2);
  font-size: var(--fs-cap);
}

.chip--on {
  background: var(--brand-soft);
  color: var(--brand-ink);
  font-weight: 600;
}

/* ============================================================
   列表行（设置类页面用）
   ============================================================ */

.cells {
  /* 由 .card 提供白底与内边距 */
}

.cell {
  display: flex;
  align-items: center;
  min-height: 54px;
  border-bottom: 1px solid var(--line);
}

.cell:last-child {
  border-bottom: none;
}

.cell:active {
  opacity: 0.7;
}

.cell__emoji {
  width: 34px;
  font-size: 18px;
  line-height: 1;
}

.cell__label {
  flex: 1;
  font-size: var(--fs-h3);
  color: var(--ink-1);
}

.cell__extra {
  margin-right: 6px;
  font-size: var(--fs-cap);
  color: var(--ink-3);
}

.cell__extra--warn {
  color: var(--warning);
}

/* 数字角标（P20 消息中心行）。文案来自 utils/mine-view.ts 的 buildUnreadBadge()，
   与底部 Tab 的角标同一个数字 —— 两处各算一遍迟早会不一致。 */
.cell__badge {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 20px;
  height: 20px;
  padding: 0 6px;
  margin-right: 6px;
  border-radius: var(--radius-pill);
  background: var(--brand-ink);
  color: #ffffff;
  font-size: var(--fs-cap);
  line-height: 1;
}

.cell__arrow {
  color: var(--ink-3);
  font-size: 14px;
}

/* ============================================================
   空状态
   ============================================================ */

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40px 20px;
}

.empty__emoji {
  font-size: 40px;
  line-height: 1;
}

.empty__title {
  margin-top: 12px;
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink-1);
}

.empty__hint {
  margin-top: 6px;
  font-size: var(--fs-cap);
  color: var(--ink-3);
  text-align: center;
}

/* ============================================================
   骨架期提示条（M1 完成后删除）
   ============================================================ */

.skeleton-note {
  margin-bottom: 14px;
  padding: 10px 14px;
  border-radius: var(--radius-md);
  background: var(--pastel-yellow);
  color: #8a6d1f;
  font-size: var(--fs-cap);
  line-height: 1.5;
}
