/* 整页遮罩 —— 规格见 docs/07 §6.11。
   刻意不做成「白卡片 + 转圈」（那是系统 wx.showLoading 的样子）。
   这里是一层暖纱：下面的字还在，只是点不动了。
   透明度别太高，否则用户会以为页面崩了。 */

.busy {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(253, 246, 247, 0.82);
}

.busy__dots {
  display: flex;
}

.busy__dot {
  width: 9px;
  height: 9px;
  margin: 0 5px;
  border-radius: 50%;
  background: var(--brand-ink);
  animation: busy-bounce 1s ease-in-out infinite;
}

.busy__dot:nth-child(2) {
  animation-delay: 0.15s;
}

.busy__dot:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes busy-bounce {
  0%,
  70%,
  100% {
    transform: translateY(0);
    opacity: 0.45;
  }
  35% {
    transform: translateY(-6px);
    opacity: 1;
  }
}

.busy__text {
  margin-top: 14px;
  color: var(--ink-2);
  font-size: var(--fs-body);
}
