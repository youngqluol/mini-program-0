# =============================================================
# 后端环境变量模板
# =============================================================
# 用法：
#   cp server/.env.example server/.env
# 然后把真实值填进 .env（.env 已被 .gitignore 忽略，绝不提交）
#
# 生产环境的值配在「微信云托管控制台 → 服务配置 → 环境变量」，不落文件。
# =============================================================


# -------------------------------------------------------------
# 1. 基础
# -------------------------------------------------------------
NODE_ENV=development
PORT=3000
# 存储层用 UTC，Node 进程用北京时间 —— 这样接口层直接取本地时间即得北京时间。
# 完整推导见 docs/01 §4.3。
TZ=Asia/Shanghai


# -------------------------------------------------------------
# 2. 数据库 / 缓存
# -------------------------------------------------------------
# ⚠️ 不要加 ?timezone=+08:00 —— Prisma 的 MySQL 连接器不支持这个参数
#    （prisma/orm#29517 至今 open，会被静默忽略）。
#    它固定按 UTC 读写 DATETIME，北京时间只在接口层格式化。
DATABASE_URL="mysql://root:root@127.0.0.1:3306/family_things"
REDIS_URL="redis://127.0.0.1:6379/0"


# -------------------------------------------------------------
# 3. 微信小程序
# -------------------------------------------------------------
WX_APPID=""
WX_SECRET=""
WX_ENV_ID=""

# 内容安全检测（msgSecCheck，M2-B9）总开关。**默认开**，只有显式写 false 才关。
# 关掉只适用于本地开发：微信接口要真实 access_token，本地跑冒烟会被超时拖慢。
# ⚠️ 生产环境**必须为 true** —— 用户生成文字过内容是小程序审核的硬性要求。
# 检测失败（网络 / 凭证 / 未开通）时**放行**，不阻塞家人使用，理由见
# server/src/modules/wechat/content-security.service.ts
CONTENT_SECURITY_ENABLED=true


# -------------------------------------------------------------
# 4. 鉴权
# -------------------------------------------------------------
JWT_SECRET=""
JWT_EXPIRES_IN="7d"


# -------------------------------------------------------------
# 5. 内部接口鉴权（定时任务 / 手工绑定等）
# -------------------------------------------------------------
# 云托管定时任务调用 /internal/* 时带 X-Internal-Secret
INTERNAL_CRON_SECRET=""


# -------------------------------------------------------------
# 6. 订阅消息模板（辅助通道）
#    ⚠️⚠️ 这三个是小程序【订阅消息】模板 ID，来源：
#        小程序后台 → 功能 → 订阅消息 → 公共模板库 → 选用后到「我的模板」复制
#        它们与下面第 7 节的公众号模板 ID（MP_TEMPLATE_*）**完全不是一回事**，
#        绝对不能互相填：两个接口不同、openid 不同、字段名规则也不同。
#        填错的后果是 47003 / 43101，且报错信息几乎无法定位。
#
#    判别方法：看后台模板的**字段名** ——
#      订阅消息 = thing1 / time23（公共模板库定死，改不了）
#      公众号   = first / keyword1（自定义）
#
#    字段定义与组装逻辑：server/src/modules/notify/subscribe.templates.ts
#    字段自检：cd server && pnpm run check:templates
#    链路实探：node tools/probe-subscribe.mjs <你的openid> TASK
# -------------------------------------------------------------
# ① 待办事项提醒（模板编号 2983）—— 派活
#    字段 thing1 事项主题 / thing4 事项描述 / thing22 提醒对象 / time23 提醒时间（必填）
WX_TEMPLATE_TASK=""
# ② 备忘事项提醒（模板编号 10938）—— 叮一下
#    字段 thing3 备忘事项 / time10 事项时间 / thing6 相关人员
WX_TEMPLATE_NUDGE=""
# ③ 日程任务完成提醒（模板编号 77364）—— 完成回执
#    字段 thing1 备忘事项 / thing2 完成人 / time3 完成时间
WX_TEMPLATE_DONE=""
# ⚠️ 已知缺口：① 的 time23 是必填的 time 字段，所以「派活不设时间」时这条发不出去，
#    会自动降级到站内消息（公众号模板通道不受影响）。见 docs/未来需求池.md


# -------------------------------------------------------------
# 7. 推送通道：公众号模板消息（wxpush）—— V0.1 验证期主力
#    完整方案见 docs/08-wxpush推送集成方案.md
# -------------------------------------------------------------

# 通道总开关。产品化拆除 wxpush 时只需把它置为 false，业务代码不动
NOTIFY_MP_ENABLED=true

# Cloudflare Worker 地址与访问令牌（令牌需与 Worker 的 API_TOKEN 一致）
WXPUSH_URL="https://<你的worker域名>.workers.dev"
WXPUSH_TOKEN=""

# 三个公众号模板 ID（测试号后台「模板消息接口」里创建）
# ⚠️ 字段名必须与 server/src/modules/notify/notify.templates.ts 里的
#    MP_TEMPLATE_SPECS[].body 完全一致，否则微信返回 47003。
#    模板内容原文见 docs/08-wxpush推送集成方案.md。
#
# ① 待办事项提醒 —— 用于「派活」（first/keyword1~4/remark）
MP_TEMPLATE_TASK=""
# ② 备忘事项提醒 —— 用于「叮一下」（first/keyword1~3/remark）
MP_TEMPLATE_REMINDER=""
# ③ 日程任务完成提醒 —— 用于「完成回执」（first/keyword1~3/remark）
MP_TEMPLATE_DONE=""

# 点击模板消息要打开的小程序页面
MP_APPID=""
MP_PAGEPATH="pages/index/index"

# 测试号「接口配置信息」里的 Token，用于校验微信回调签名
MP_CALLBACK_TOKEN=""


# -------------------------------------------------------------
# 8. 对象存储（头像 / 留个念图片）
# -------------------------------------------------------------
COS_BUCKET=""
COS_REGION=""
COS_SECRET_ID=""
COS_SECRET_KEY=""
